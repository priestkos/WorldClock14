<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline harness: compiles the plugin's real logic file with NO Dalamud, no dev distrib and no game.
    <Compile Include> rather than a copy, so this can never drift from the shipped code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LogicTests</AssemblyName>
    <RootNamespace>TimeShiftXIV.LogicTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\TimeConversion.cs" />
    <Compile Include="..\..\Defaults.cs" />
  </ItemGroup>
</Project>
