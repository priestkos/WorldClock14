<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>Convert a time into every timezone you care about and copy the result straight into chat.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>WorldClock14</Name>
    <Punchline>One time, every timezone, one click to chat.</Punchline>
    <RepoUrl>https://github.com/priestkos/WorldClock14</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/priestkos/WorldClock14/main/images/icon.png</IconUrl>
    <Tags>timezone;utility</Tags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The offline logic harness is a separate console project; keep it out of the plugin build. -->
    <Compile Remove="tests\**" />
  </ItemGroup>
</Project>
